# CrazyGames release profile.
# Copy the Firebase Web App values from .env.example into this file before
# running `npm run build:crazygames`. These values are public client config,
# but they still must point to the correct Firebase project.

# Firebase Web App configuration (copy real values from .env.example here for
# a standalone local CrazyGames-mode build, or provide them in CI secrets).
# These stay commented so this profile does not override a working local .env
# with placeholder values.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_DATABASE_URL=

# Firebase runtime
VITE_USE_FIREBASE_EMULATORS=false
# Enable only after Functions are deployed and staging acceptance checks pass.
VITE_SERVER_AUTHORITY_ENABLED=false
# Must match functions/.env DYUT_FUNCTION_REGION.
VITE_FUNCTIONS_REGION=asia-south1

# CrazyGames and ads
VITE_CRAZYGAMES_BUILD=true
# Keep aligned with functions/.env CG_ENABLE_ADS.
VITE_CG_ENABLE_ADS=false
VITE_ADS_PROVIDER=crazygames
# Configure this only after CrazyGames enables a leaderboard for the game.
VITE_CRAZYGAMES_LEADERBOARD_ENCRYPTION_KEY=

# Gameplay timing
VITE_ONLINE_TURN_TIMEOUT_MS=30000
VITE_LOCAL_TURN_TIMEOUT_MS=60000
VITE_TURN_TIMER_WARNING_MS=10000
VITE_AFK_BOT_TAKEOVER_STRIKES=6
