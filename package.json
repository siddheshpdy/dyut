{
  "name": "dyut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:crazygames": "vite build --mode crazygames",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:functions": "npm --prefix functions test",
    "test:functions:emulator": "firebase emulators:exec --only functions \"node scripts/functions-emulator-health.mjs\"",
    "test:emulators": "firebase --config firebase.emulator.json emulators:exec --only auth,firestore,database,functions \"npm run test:functions && npm --prefix functions run test:integration && npm run test:two-client\"",
    "test:two-client": "node scripts/two-client-authority-smoke.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --ui",
    "test:ui:report": "playwright show-report artifacts/playwright-report",
    "test:all": "npm test && npm run test:ui",
    "capture:screenshots": "node scripts/capture-crazygames-screenshots.mjs",
    "capture:screenshots:crazygames": "node scripts/capture-crazygames-screenshots.mjs --portal",
    "capture:covers": "node scripts/capture-crazygames-covers.mjs",
    "capture:preview-videos": "node scripts/capture-crazygames-preview-videos.mjs"
  },
  "dependencies": {
    "firebase": "^10.10.0",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "firebase-tools": "^13.35.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
