rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Online match stats, economy, inventory, settlements, and leaderboard
    // projections are Function-owned. Offline counters remain owner-writable
    // because offline play is intentionally client-local and noncompetitive;
    // leaderboardEntries never trusts these profile counters.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'lastLogin', 'createdAt',
          'savedResumeGame', 'resumeGame', 'gamesPlayed', 'wins', 'modeStats'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'lastLogin', 'savedResumeGame', 'resumeGame',
          'gamesPlayed', 'wins', 'modeStats'
        ]);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /walletLedger/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /matchSettlements/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow write: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if false;

      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /leaderboardEntries/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /storeProducts/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /inventory/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
