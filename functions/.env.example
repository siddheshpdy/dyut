# Copy to functions/.env for local deployment/emulator configuration.
# The Functions .env is ignored by git. Never commit private credentials here.
# Firebase Admin credentials are supplied by Firebase/GCP at deploy time; no
# VITE_* browser keys belong in this file.

# -----------------------------------------------------------------------------
# Deployment location
# -----------------------------------------------------------------------------
# Keep this equal to VITE_FUNCTIONS_REGION in the web build. The DYUT_ prefix
# is required because FUNCTION_REGION is reserved by Firebase.
DYUT_FUNCTION_REGION=asia-south1
# RTDB trigger region. Keep this equal to the region of the RTDB instance.
# The legacy onlinedyut project uses us-central1; replace this for projects
# created in another region before deploying that project.
DATABASE_REGION=us-central1
# RTDB URL for the Firebase project being deployed. This is project-specific
# configuration; keep the actual value in ignored functions/.env or CI secrets.
DATABASE_URL=https://replace_with_database_instance.firebasedatabase.app/

# -----------------------------------------------------------------------------
# Economy and portal behavior
# -----------------------------------------------------------------------------
# Keep this equal to VITE_CG_ENABLE_ADS in the web build.
CG_ENABLE_ADS=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# false for local emulators; set true only after Firebase App Check is enabled
# for the deployed web app and the staging calls pass.
ENFORCE_APP_CHECK=false

# -----------------------------------------------------------------------------
# Cloud Functions scaling/cost controls
# -----------------------------------------------------------------------------
# Lower max instances reduces burst cost; increase only after load testing.
FUNCTION_MAX_INSTANCES=20
# Higher concurrency can reduce idle instances; validate under expected load.
FUNCTION_CONCURRENCY=40
