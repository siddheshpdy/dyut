# Copy this file to .env for local website development.
# Do not commit .env. Values beginning with VITE_ are bundled into the browser,
# so never put Firebase Admin credentials or other private secrets here.

# -----------------------------------------------------------------------------
# Firebase Web App configuration (Firebase Console > Project settings > Web app)
# Required for Google sign-in, profiles, online games, and rankings.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_messaging_sender_id
VITE_FIREBASE_APP_ID=replace_with_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=replace_with_measurement_id
VITE_FIREBASE_DATABASE_URL=https://replace_with_database_instance.firebasedatabase.app/

# -----------------------------------------------------------------------------
# Firebase runtime and server-authority rollout
# -----------------------------------------------------------------------------
# true only when running the local Auth/Firestore/RTDB/Functions emulators.
VITE_USE_FIREBASE_EMULATORS=false
# Keep false until Functions are deployed and staging acceptance checks pass.
VITE_SERVER_AUTHORITY_ENABLED=false
# Must match functions/.env FUNCTION_REGION.
VITE_FUNCTIONS_REGION=asia-south1

# -----------------------------------------------------------------------------
# Portal/build integrations
# -----------------------------------------------------------------------------
# true for the CrazyGames build; false for a normal website build.
VITE_CRAZYGAMES_BUILD=false
# Client-side ad UI flag. Keep aligned with functions/.env CG_ENABLE_ADS.
VITE_CG_ENABLE_ADS=false
# crazygames, google, none, or auto. CrazyGames builds resolve to CrazyGames.
VITE_ADS_PROVIDER=auto
# Optional: only fill after CrazyGames enables the leaderboard for this game.
VITE_CRAZYGAMES_LEADERBOARD_ENCRYPTION_KEY=
# Optional standalone Google publisher ID. Not required for the CrazyGames build.
VITE_GOOGLE_ADS_CLIENT_ID=

# -----------------------------------------------------------------------------
# Gameplay timing (positive whole-number milliseconds unless noted)
# -----------------------------------------------------------------------------
VITE_ONLINE_TURN_TIMEOUT_MS=30000
VITE_LOCAL_TURN_TIMEOUT_MS=60000
VITE_TURN_TIMER_WARNING_MS=10000
VITE_AFK_BOT_TAKEOVER_STRIKES=6

